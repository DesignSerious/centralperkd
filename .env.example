# Copy this file to ".env" (gitignored) for local dev. `npm run dev` loads
# it automatically (dev:server uses node --env-file-if-exists=.env).
# In production set these in the host/Railway dashboard, NOT a committed file.

# OpenAI key for the "Generate a piece with AI" feature. Without it the
# generator is disabled with "AI piece generation is not configured".
OPENAI_API_KEY=

# Secret that signs player-account tokens. Without it a dev default is used
# (tokens reset on restart). Use a long random string in production.
AUTH_SECRET=

# Optional: where the accounts SQLite DB lives. Defaults to
# server/data/friends-trivia.db. Point this at a persistent volume in prod.
# FRIENDS_TRIVIA_DB=

# Optional: password for the /playlist admin (defaults to "centralperkd").
# PLAYLIST_PASSWORD=

# Optional: HTTP port (defaults to 3000).
# PORT=3000
